# --- API authentication ---
# Leave empty to disable auth (development mode).
API_TOKEN=

# --- Target URL allowlist ---
ALLOWED_TARGET_HOSTS=localhost,127.0.0.1,target-service,httpbin.org

# --- Database ---
POSTGRES_USER=loadtest
POSTGRES_PASSWORD=loadtest
POSTGRES_DB=loadtest
DATABASE_URL=postgresql+asyncpg://loadtest:loadtest@postgres:5432/loadtest

# --- Redis ---
REDIS_URL=redis://redis:6379/0
